# App mode: "development" or "production" (defaults to __DEV__ when unset)
EXPO_PUBLIC_APP_MODE=development

# Clerk authentication (publishable key — must be the SAME Clerk instance the
# backend verifies against, or auth will fail)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Next.js backend (data API): calls history, contacts, balance, plans,
# number configs, transcripts, recordings. This is usetalktool.com in prod.
EXPO_PUBLIC_BACKEND_URL=https://usetalktoolfrontend.ngrok.app

# Web dashboard (opened in Safari for plan subscribe / billing). Usually the
# same host as EXPO_PUBLIC_BACKEND_URL. Must be the same Clerk instance.
EXPO_PUBLIC_WEB_URL=https://usetalktoolfrontend.ngrok.app

# LiveKit call server (livekit-server.js): /livekit/place-call, /livekit/token,
# /call/display socket, /agent/notify, availability. Despite the var name this
# is NOT the legacy Twilio server. Run it locally on :8090 and expose via ngrok.
EXPO_PUBLIC_TWILIO_SERVER_URL=https://usetalktoolserver.ngrok.app

# WebSocket host for live transcripts. MUST name the SAME livekit-server host as
# EXPO_PUBLIC_TWILIO_SERVER_URL (place-call creates the session the socket reads).
# If unset, constants.ts derives it from TWILIO_SERVER_URL automatically.
EXPO_PUBLIC_WEBSOCKET_URL=wss://usetalktoolserver.ngrok.app

# Live-translate feature WebSocket (separate live-trans backend)
EXPO_PUBLIC_LIVE_TRANS_URL=wss://live-trans.usetalktool.com

# EAS project id (for builds + push notifications)
EXPO_PUBLIC_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
