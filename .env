# App Mode: "development" or "production"
EXPO_PUBLIC_APP_MODE=development

# Clerk Authentication
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_ZW1lcmdpbmctaGlwcG8tMjkuY2xlcmsuYWNjb3VudHMuZGV2JA

# Next.js Backend (user data, calls history, contacts, dashboard)
EXPO_PUBLIC_BACKEND_URL=https://usetalktoolfrontend.ngrok.app

# Web Dashboard URL (for opening in Safari - must match same Clerk instance as backend)
EXPO_PUBLIC_WEB_URL=https://usetalktoolfrontend.ngrok.app

# LiveKit call server (livekit-server.js), deployed on Fly. Both must be the
# same host. (Was usetalktoolserver.ngrok.app; now the deployed static host.)
EXPO_PUBLIC_TWILIO_SERVER_URL=https://numberlang-livekit-server.fly.dev
EXPO_PUBLIC_WEBSOCKET_URL=wss://numberlang-livekit-server.fly.dev

# Live Translation WebSocket (live-trans backend)
EXPO_PUBLIC_LIVE_TRANS_URL=ws://localhost:3002

# Optional: EAS Project ID (for push notifications)
EXPO_PUBLIC_PROJECT_ID=
